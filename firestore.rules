rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && userId == request.auth.uid;
    }

    function isPetOwner(petId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/pets/$(petId)
        ).data.ownerId == request.auth.uid;
    }

    // USERS
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // PETS
    match /pets/{petId} {
      allow create: if isOwner(request.resource.data.ownerId);

      allow read, delete: if isOwner(resource.data.ownerId);

      allow update: if isOwner(resource.data.ownerId)
        && isOwner(request.resource.data.ownerId);
    }

    // APPOINTMENTS
    match /appointments/{appointmentId} {
      allow create: if isOwner(request.resource.data.userId)
        && isPetOwner(request.resource.data.petId);

      allow read, delete: if isPetOwner(resource.data.petId);
allow update: if isPetOwner(resource.data.petId)
  && isOwner(request.resource.data.userId)
  && request.resource.data.userId == resource.data.userId
  && isPetOwner(request.resource.data.petId);
    }

    // HEALTH RECORDS
    match /healthRecords/{recordId} {
      allow create: if isOwner(request.resource.data.ownerId)
        && isPetOwner(request.resource.data.petId);

      allow read, delete: if isOwner(resource.data.ownerId)
        || (
          resource.data.keys().hasAll(['petId'])
          && isPetOwner(resource.data.petId)
        );

      allow update: if isPetOwner(resource.data.petId)
        && isOwner(request.resource.data.ownerId)
        && isPetOwner(request.resource.data.petId);
    }

    // VACCINATION RECORDS
    match /vaccinationRecords/{recordId} {
      allow create: if isOwner(request.resource.data.ownerId)
        && isPetOwner(request.resource.data.petId);

      allow read, delete: if isOwner(resource.data.ownerId)
        || (
          resource.data.keys().hasAll(['petId'])
          && isPetOwner(resource.data.petId)
        );

      allow update: if isPetOwner(resource.data.petId)
        && isOwner(request.resource.data.ownerId)
        && isPetOwner(request.resource.data.petId);
    }

    // VACCINATION SERIES
    match /vaccinationSeries/{serieId} {
      allow create: if isOwner(request.resource.data.ownerId)
        && isPetOwner(request.resource.data.petId);

      allow read, delete: if isOwner(resource.data.ownerId)
        && isPetOwner(resource.data.petId);

      allow update: if isOwner(resource.data.ownerId)
        && isPetOwner(resource.data.petId)
        && isOwner(request.resource.data.ownerId)
        && isPetOwner(request.resource.data.petId);
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow create: if isOwner(request.resource.data.userId);

      allow read, delete: if isOwner(resource.data.userId);

      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    // DENY EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}